# Server-side env file for docker-compose.prod.yml.
# Copy to ~/apps/live/amtarc/.env on the VPS and fill in real values —
# never commit the filled-in version.

# Domain this stack is routed under by Traefik (not decided yet — see
# CLAUDE-context-amtarc.md). Example: amtarc.fr
DOMAIN=

# Pin a specific build instead of always running the latest push to main.
# Find tags at https://github.com/supremjerem/amtarc/pkgs/container/amtarc-web
IMAGE_TAG=latest

# Database
POSTGRES_PASSWORD=

# API secrets — generate with: openssl rand -base64 32 (min 24 chars, no placeholders)
JWT_SECRET=
JWT_EXPIRES_IN=7d
REVALIDATE_SECRET=

# Admin back-office account (min 12 chars for the password)
ADMIN_EMAIL=admin@amtarc.fr
ADMIN_PASSWORD=

# Transactional email — MAIL_DRIVER=log until a Resend key is provisioned
MAIL_DRIVER=log
MAIL_FROM=AMTARC <no-reply@amtarc.fr>
RESEND_API_KEY=
