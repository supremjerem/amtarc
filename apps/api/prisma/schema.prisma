generator client {
  provider      = "prisma-client"
  output        = "../generated/prisma"
  moduleFormat  = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum NewsCategory {
  CONCOURS
  TRAVAUX
  EVENEMENT
}

model News {
  id          String       @id @default(cuid())
  slug        String       @unique
  title       String
  category    NewsCategory
  imageUrl    String?
  excerpt     String?
  body        String
  published   Boolean      @default(true)
  publishedAt DateTime?    @default(now())
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

// Editable site copy, one row per page section (hero, announcements, ...).
// The web app merges stored sections over its built-in defaults, so rows
// only exist for sections an admin has actually edited.
model SiteContent {
  key       String   @id
  data      Json
  updatedAt DateTime @updatedAt
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
}
