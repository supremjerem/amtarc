generator client {
  provider      = "prisma-client"
  output        = "../src/generated/prisma"
  moduleFormat  = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum NewsCategory {
  CONCOURS
  TRAVAUX
  EVENEMENT
}

model News {
  id          String       @id @default(cuid())
  slug        String       @unique
  title       String
  category    NewsCategory
  imageUrl    String?
  excerpt     String?
  body        String
  published   Boolean      @default(true)
  publishedAt DateTime?    @default(now())
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

// IPSC matches organized by the club. Registrations arrive in a later phase;
// payment is by bank transfer to the host club (per-match payment fields).
model Match {
  id                   String    @id @default(cuid())
  title                String
  description          String?
  location             String
  startDate            DateTime
  endDate              DateTime
  stages               Int?
  rounds               Int?
  feeCents             Int       @default(0)
  registrationDeadline DateTime?
  published            Boolean   @default(false)
  paymentIban          String?
  paymentPayee         String?
  paymentInstructions  String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  squads               Squad[]
  registrations        Registration[]
}

model Squad {
  id         String   @id @default(cuid())
  matchId    String
  match      Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  label      String
  day        DateTime
  startTime  String
  targetSize Int      @default(12)
  position   Int      @default(0)
}

enum Division {
  OPEN
  STANDARD
  PRODUCTION
  REVOLVER
  CLASSIC
  PRODUCTION_OPTICS
  OPTICS
  PCC
}

enum ShooterCategory {
  OVERALL
  JUNIOR
  LADY
  SENIOR
  SUPER_SENIOR
}

enum RegistrationStatus {
  AWAITING_PAYMENT
  CONFIRMED
  WAITLISTED
  CANCELLED
}

// A shooter's entry to a match. `reference` is the human-friendly code used as
// the bank-transfer label so organizers can match payments to entries.
// squadId stays null until squadding (phase 3) assigns it.
model Registration {
  id            String             @id @default(cuid())
  reference     String             @unique
  matchId       String
  match         Match              @relation(fields: [matchId], references: [id], onDelete: Cascade)
  squadId       String?
  firstName     String
  lastName      String
  email         String
  licenceNumber String
  club          String?
  region        String?
  division      Division
  category      ShooterCategory    @default(OVERALL)
  status        RegistrationStatus @default(AWAITING_PAYMENT)
  paidAt        DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  squadRequests SquadRequest[]

  @@unique([matchId, email])
}

// Free-text "I want to shoot with…" wishes, input to the squadding algorithm.
model SquadRequest {
  id             String       @id @default(cuid())
  registrationId String
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  requestedName  String
}

// Editable site copy, one row per page section (hero, announcements, ...).
// The web app merges stored sections over its built-in defaults, so rows
// only exist for sections an admin has actually edited.
model SiteContent {
  key       String   @id
  data      Json
  updatedAt DateTime @updatedAt
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
}
