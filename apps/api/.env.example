DATABASE_URL="postgresql://amtarc:amtarc@localhost:5432/amtarc"
# Secrets below are placeholders on purpose: the API refuses to boot until they
# are replaced (min 24 characters). Generate one with: openssl rand -base64 32
JWT_SECRET="change-me"
JWT_EXPIRES_IN="7d"
PORT=3001
# Reverse-proxy hops in front of the API (0 when exposed directly).
TRUST_PROXY=0
CORS_ORIGIN="http://localhost:3000"
ADMIN_EMAIL="admin@amtarc.fr"
# Min 12 characters. Guards the only account that can reach the back-office.
ADMIN_PASSWORD="change-me"
WEB_REVALIDATE_URL="http://localhost:3000/api/revalidate"
REVALIDATE_SECRET="change-me"
API_PUBLIC_URL="http://localhost:3001"
MAIL_DRIVER="log"
MAIL_FROM="AMTARC <no-reply@amtarc.fr>"
RESEND_API_KEY=""
